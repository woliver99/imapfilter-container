# ==============================================================================
# imapfilter-container Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Account 1 - Example: Microsoft Account (Hotmail / Outlook / Office365) via OAuth 2.0
# Generate your refresh token once by running: python3 scripts/get_microsoft_token.py
# ------------------------------------------------------------------------------
ACCOUNT_1_USER=your_email@hotmail.com
ACCOUNT_1_REFRESH_TOKEN=your_oauth2_refresh_token_here
# Rule templates to run for this account (defaults to: whitelist,newsletter)
ACCOUNT_1_RULES=whitelist,newsletter

# Optional Account 1 overrides:
# ACCOUNT_1_NAME="Personal Hotmail"
# ACCOUNT_1_SERVER=outlook.office365.com
# ACCOUNT_1_PORT=993
# ACCOUNT_1_SSL=auto
# ACCOUNT_1_NEWSLETTERS_FOLDER=Newsletters
# ACCOUNT_1_JUNK_FOLDER=Junk
# ACCOUNT_1_WHITELIST_FOLDER=Whitelist

# ------------------------------------------------------------------------------
# Account 2 - Example: Standard IMAP Account via Password / App Password
# (e.g. Gmail App Password, Fastmail, Yahoo, self-hosted mail server)
# ------------------------------------------------------------------------------
# ACCOUNT_2_USER=your_email@gmail.com
# ACCOUNT_2_PASS=your_app_password
# ACCOUNT_2_SERVER=imap.gmail.com
# ACCOUNT_2_PORT=993
# ACCOUNT_2_RULES=whitelist,newsletter

# ------------------------------------------------------------------------------
# Additional Accounts:
# Add ACCOUNT_3_USER, ACCOUNT_4_USER, etc., using either PASS or REFRESH_TOKEN.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# ntfy Push Notifications (Optional)
# Receive instant push notifications on repeated account failures/expiration.
# ------------------------------------------------------------------------------
# NTFY_URL=https://ntfy.sh/your-secret-topic
# Optional Bearer token for protected topics:
# NTFY_TOKEN=tk_123456789abcdef
# Number of consecutive failures before sending an alert (default: 3)
# NTFY_ERROR_THRESHOLD=3

# Service Check Interval in seconds (default: 600 = 10 minutes)
CHECK_INTERVAL=600

