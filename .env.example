# ==============================================================================
# imapfilter-container Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Account 1 (Required)
# ------------------------------------------------------------------------------
ACCOUNT_1_USER=your_first_email@hotmail.com
ACCOUNT_1_PASS=your_app_password_here
# Rule templates to run for this account (defaults to: whitelist,newsletter)
ACCOUNT_1_RULES=whitelist,newsletter

# Optional Account 1 overrides:
# ACCOUNT_1_NAME="Personal Email"
# ACCOUNT_1_SERVER=outlook.office365.com
# ACCOUNT_1_PORT=993
# ACCOUNT_1_SSL=auto
# ACCOUNT_1_NEWSLETTERS_FOLDER=Newsletters
# ACCOUNT_1_JUNK_FOLDER=Junk
# ACCOUNT_1_WHITELIST_FOLDER=Whitelist

# ------------------------------------------------------------------------------
# Account 2 (Optional - uncomment to enable)
# ------------------------------------------------------------------------------
# ACCOUNT_2_USER=your_second_email@outlook.com
# ACCOUNT_2_PASS=your_second_app_password
# ACCOUNT_2_RULES=whitelist,newsletter,receipts
# ACCOUNT_2_NAME="Work Email"

# ------------------------------------------------------------------------------
# Additional Accounts:
# Add ACCOUNT_3_USER, ACCOUNT_3_PASS, ACCOUNT_4_USER, etc., as needed.
# ------------------------------------------------------------------------------

# Service Check Interval in seconds (default: 600 = 10 minutes)
CHECK_INTERVAL=600
