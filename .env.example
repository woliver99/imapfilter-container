# ==============================================================================
# imapfilter-container Multi-Account Configuration
# ==============================================================================
#
# NOTE: If Two-Step Verification (2FA) is enabled on your Microsoft account,
# you MUST generate an App Password:
# 1. Sign in to https://account.live.com/proofs/manage/additional
# 2. Under "App passwords", select "Create a new app password"
# 3. Paste the generated 16-character password below (without spaces)

# ------------------------------------------------------------------------------
# Account 1 (Required)
# ------------------------------------------------------------------------------
ACCOUNT1_USER=your_first_email@hotmail.com
ACCOUNT1_PASS=your_app_password_here
# Optional overrides for Account 1:
# ACCOUNT1_NAME="Personal Hotmail"
# ACCOUNT1_SERVER=outlook.office365.com
# ACCOUNT1_PORT=993
# ACCOUNT1_SSL=auto
# ACCOUNT1_NEWSLETTERS_FOLDER=Newsletters
# ACCOUNT1_JUNK_FOLDER=Junk
# ACCOUNT1_JUNK_DAYS=14

# ------------------------------------------------------------------------------
# Account 2 (Optional - uncomment to enable)
# ------------------------------------------------------------------------------
# ACCOUNT2_USER=your_second_email@outlook.com
# ACCOUNT2_PASS=your_second_app_password_here
# ACCOUNT2_NAME="Work Outlook"
# ACCOUNT2_SERVER=outlook.office365.com
# ACCOUNT2_PORT=993
# ACCOUNT2_SSL=auto
# ACCOUNT2_NEWSLETTERS_FOLDER=Newsletters
# ACCOUNT2_JUNK_FOLDER=Junk
# ACCOUNT2_JUNK_DAYS=14

# ------------------------------------------------------------------------------
# Additional Accounts:
# Add ACCOUNT3_USER, ACCOUNT3_PASS, ACCOUNT4_USER, etc., as needed.
# ------------------------------------------------------------------------------

# Service Check Interval (in seconds, default: 600 = 10 minutes)
# CHECK_INTERVAL=600
